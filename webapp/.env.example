# =============================================================================
# Caries Segmentation Web App — Environment Variables
#
# Copy this file to .env and fill in the values before running
# `docker compose up`.  The .env file must NOT be committed to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=caries
POSTGRES_PASSWORD=change_me_before_production
POSTGRES_DB=caries_seg

# ---------------------------------------------------------------------------
# Backend
#
# DATABASE_URL is constructed automatically by docker-compose.yml from the
# POSTGRES_* variables above.  Override here only if you run the backend
# outside of Compose (e.g. local development).
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://caries:change_me_before_production@localhost:5432/caries_seg

# Absolute path inside the backend container where uploads and masks are stored.
# Maps to the `storage_vol` Docker volume.
STORAGE_ROOT=/storage

# Absolute path inside the backend container where model checkpoints live.
# Maps to the read-only bind mount of the monorepo's files/ directory.
MODEL_ROOT=/models

# Maximum pixel size (longest edge) for the display copy saved alongside
# each uploaded image.  Reduces canvas render time in the browser.
MAX_DISPLAY_PX=1600

# Inference device.  Set to "cuda" if the host has an NVIDIA GPU configured
# with the Docker NVIDIA runtime; otherwise leave as "cpu".
DEVICE=cpu
