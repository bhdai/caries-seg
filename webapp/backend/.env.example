# =============================================================================
# Backend local development environment
#
# Copy this file to .env and fill in the values:
#
#   cp .env.example .env
#
# .env is gitignored — never commit real credentials.
# In Docker these variables are supplied by docker-compose.yml's env_file
# directive, so .env is only needed for local CLI development.
# =============================================================================

# ---------------------------------------------------------------------------
# Database
#
# For local dev, Postgres runs in Docker while the backend runs on the host.
# Use localhost:5432 instead of the Docker service name "postgres".
#
#   docker compose -f ../docker-compose.yml up postgres -d
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://caries:caries@localhost:5432/caries_seg

# ---------------------------------------------------------------------------
# File storage
#
# Uploaded images and generated masks are written here.
# The path is relative to the webapp/backend/ working directory.
# Create it before starting the server:
#
#   mkdir -p ./tmp/storage
# ---------------------------------------------------------------------------
STORAGE_ROOT=./tmp/storage

# ---------------------------------------------------------------------------
# Model checkpoints
#
# Points to the monorepo files/ directory that holds trained model weights.
# Relative to webapp/backend/.
# ---------------------------------------------------------------------------
MODEL_ROOT=../../files

# ---------------------------------------------------------------------------
# Inference device
#
# Optional.  Defaults to "auto", which prefers CUDA when the current Torch
# install can see an NVIDIA GPU and otherwise falls back to CPU.
# Set DEVICE=cpu to force CPU execution or DEVICE=cuda to fail fast unless
# CUDA is actually available.
# ---------------------------------------------------------------------------
# DEVICE=auto

# ---------------------------------------------------------------------------
# Authentication — JWT
#
# JWT_SECRET is required.  Generate a strong random value, for example:
#
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# JWT_ALGORITHM and JWT_EXPIRY_HOURS have sensible defaults and can be
# omitted unless you need to override them.
# ---------------------------------------------------------------------------
JWT_SECRET=change_me_to_a_long_random_secret
# JWT_ALGORITHM=HS256
# JWT_EXPIRY_HOURS=8

# ---------------------------------------------------------------------------
# Authentication — Cookie
#
# COOKIE_SECURE=False is appropriate for local HTTP development.
# Set to True in production (HTTPS).
# COOKIE_DOMAIN is optional; omit for single-domain deployments.
# ---------------------------------------------------------------------------
# COOKIE_SECURE=False
# COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Seed admin
#
# When both vars are set and the users table is empty at startup, a bootstrap
# admin account is created automatically.  The seed is a no-op on subsequent
# restarts once any user exists.  Remove or comment out these vars after the
# initial deployment to prevent accidental re-seeding on a restored database.
# ---------------------------------------------------------------------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me_on_first_login

# ---------------------------------------------------------------------------
# Google OAuth2
#
# All three vars are optional.  Leave them unset (commented out) to disable
# Google login entirely — the /api/auth/google* endpoints will return 404.
#
# To enable:
#  1. Create a project in Google Cloud Console.
#  2. Enable the "Google Identity" OAuth consent screen.
#  3. Create OAuth 2.0 credentials (Web application type).
#  4. Add the callback URL to the authorised redirect URIs, e.g.:
#       http://localhost:8000/api/auth/google/callback  (local dev)
#       https://example.com/api/auth/google/callback    (production)
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
